      "backend": "neutral_fingerprint",
      "launches_target": false
    },
    {
      "id": "ttg.reverse.apk_views.v1",
      "effect": "draft",
      "backend": "apk_extractor_workflow",
      "launches_target": false,
      "external_tools": [
        "apktool",
        "jadx"
      ]
    },
    {
      "id": "ttg.reverse.pe_exports.v1",
      "effect": "observe",
      "backend": "app_recover_static",
      "launches_target": false
    },
    {
      "id": "ttg.reverse.rea_inspect.v1",
      "effect": "observe",
      "backend": "rea_cli",
      "launches_target": false
    }
  ],
  "source_authority": [
