{
  "schema": "ttg.ptah.reverse-engineering.provider-candidate.v1",
  "status": "not_admitted",
  "disposition": "external_adapters_only",
  "input_policy": {
    "materialized_local_path_required": true,
    "owner_grant_required": true,
    "regular_files_or_js_application_directory": true,
    "source_mutation": false,
    "output_directory_must_be_new": true
  },
  "ptah_boundary": {
    "admission": "caller_authorized_workspace_and_grant",
