{
  "schema_version": "0.1.0",
  "record_type": "ptah.phase0c.development_host_contract",
  "status": "candidate_for_physical_proof",
  "purpose": "Qualify a real physical development host for first Ptah runtime implementation without binding Ptah identity to a specific operating-system distribution or kernel.",
  "host_model": {
    "physical_or_bare_host_required": true,
    "specific_os_distribution_required": false,
    "specific_kernel_required": false,
    "dedicated_guest_os_required": false,
    "dedicated_virtual_machine_required": false,
    "container_required": false
  },
  "required_capabilities": [
    "process_spawn",
    "temporary_workspace",
    "file_fsync",
    "atomic_replace",
    "advisory_file_lock",
    "monotonic_clock",
    "local_stream_socket",
    "thread_execution"
  ],
  "required_observations": [
    "os",
    "kernel",
    "architecture",
    "cpu_count",
    "memory_bytes",
    "free_disk_bytes"
  ],
  "repository_binding": {
    "clean_checkout_required_for_physical_proof": true,
    "exact_commit_required_for_physical_proof": true
  },
  "control_plane": {
    "provider_neutral": true,
    "external_transport_receipt_required_by_private_acceptance_policy": true,
    "transport_receipt_is_not_runtime_correctness_proof": true
  },
  "deferred_deployment_capabilities": [
    "host_resource_accounting_and_enforcement",
    "workload_isolation",
    "secure_capability_ipc",
    "pty_or_equivalent_interactive_terminal",
    "filesystem_change_observation",
    "container_vm_or_remote_backend_integration_when_selected",
    "deployment_host_identity_projection",
    "restart_and_recovery_integration"
  ],
  "claim_boundary": {
    "development_host_eligible_does_not_mean_runtime_authorized": true,
    "development_host_eligible_does_not_mean_deployment_qualified": true,
    "development_host_eligible_does_not_mean_release_accepted": true,
    "runtime_implementation_authorized": false
  }
}
